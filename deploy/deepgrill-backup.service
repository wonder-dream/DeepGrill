[Unit]
Description=DeepGrill 备份（快照 + 清单 + **当场验证可恢复**）
Documentation=https://github.com/your-org/deepgrill#deploy

[Service]
Type=oneshot
User=deepgrill
Group=deepgrill
WorkingDirectory=/srv/deepgrill
EnvironmentFile=/srv/deepgrill/.env
# `--keep` 是保留份数：本地只留最近几份（磁盘就这么大）。
# 它做的是**快照 + 清单 + 当场自验**（`app/backup.py`），失败会让整个单元失败，
# 而失败会进观测页与退出码（ADR-0008：备份"成功"但恢复不了，只在需要它的那一天暴露）。
ExecStart=/srv/deepgrill/.venv/bin/python -m app.cli backup --dest /srv/deepgrill/backups --keep 7
# ⚠️ **异地那一跳是部署侧的事，不在仓库里**（ADR-0008 明说频率与保留策略待定）。
# 接法就是在这里加一行，让上传失败也把整个单元标红：
#   ExecStartPost=/usr/bin/rclone copy /srv/deepgrill/backups remote:deepgrill-backups

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/deepgrill/data /srv/deepgrill/backups
