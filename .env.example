# 复制为 .env 并填入实际值（.env 已 gitignore，勿提交）
LLM_API_KEY=sk-xxxx
NOWCODER_COOKIE=            # 仅本地个人牛客采集，默认不配（需同时 config.yaml nowcoder_enabled=true）
MAX_USERS=20
# 验证码邮件（163：开启 SMTP 服务后拿授权码；QQ：smtp.qq.com 授权码）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=you@163.com
SMTP_PASS=your-smtp-auth-code
# owner 预置（库无 owner 时启动自动创建，防空库抢注）
OWNER_EMAIL=owner@163.com
OWNER_PASSWORD=your-strong-password
# 本地调试恢复 /docs（生产默认禁用）
ENABLE_DOCS=1

# HTTPS 生产环境置 1（HttpOnly Cookie 加 Secure 标志）
COOKIE_SECURE=0
