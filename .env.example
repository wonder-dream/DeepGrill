# 配置模板：复制成 .env 再填真实值。
#
#   Copy-Item .env.example .env      # Windows
#   cp .env.example .env             # macOS / Linux
#
# ⚠️ `.env` 已被 .gitignore 挡住（它装的是密钥）。**只提交这个模板**，
# 不要在模板里写真实值 —— 那等于把密钥提交进库。
#
# 环境变量的优先级高于本文件：临时换一次不必改文件，
#   $env:DEEPGRILL_LLM_API_KEY = "sk-…"     # Windows PowerShell
#   export DEEPGRILL_LLM_API_KEY=sk-…       # macOS / Linux

# 模型与密钥。留空时应用**仍然起得来**：判定走降级路径（页面明确提示、
# 本轮记为「未涉及」、会话不中断），但不会真的调用模型。
DEEPGRILL_LLM_API_KEY=
DEEPGRILL_LLM_BASE_URL=https://api.deepseek.com/v1
DEEPGRILL_MODEL_INTERVIEWER=deepseek-v4.1-flash

# 库路径（相对仓库根解析）。默认 data/interview.db，一般不用改。
# DEEPGRILL_DATABASE_PATH=data/interview.db

# Cookie 的 Secure 属性。本机 http 开发留 false；**线上必须 true**。
DEEPGRILL_SESSION_COOKIE_SECURE=false
