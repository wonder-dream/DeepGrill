# 配置模板：复制成 .env 再填真实值。
#
#   Copy-Item .env.example .env      # Windows
#   cp .env.example .env             # macOS / Linux
#
# ⚠️ `.env` 已被 .gitignore 挡住（它装的是密钥）。**只提交这个模板**，
# 不要在模板里写真实值 —— 那等于把密钥提交进库。
#
# 环境变量的优先级高于本文件：临时换一次不必改文件，
#   $env:DEEPGRILL_LLM_API_KEY = "sk-…"     # Windows PowerShell
#   export DEEPGRILL_LLM_API_KEY=sk-…       # macOS / Linux

# 模型与密钥。留空时应用**仍然起得来**：判定走降级路径（页面明确提示、
# 本轮记为「未涉及」、会话不中断），但不会真的调用模型。
DEEPGRILL_LLM_API_KEY=
DEEPGRILL_LLM_BASE_URL=https://api.deepseek.com
DEEPGRILL_MODEL_INTERVIEWER=deepseek-flash

# 库路径（相对仓库根解析）。默认 data/interview.db，一般不用改。
# DEEPGRILL_DATABASE_PATH=data/interview.db

# 语音转写（决策 32：面试页默认语音作答）。
#   none（默认）= 没接供应商：每次调用**明确失败**，页面让人改用打字（不拿假转写骗判分）
#   fake        = 占位实现：返回一段**标着占位**的文字，只为把
#                 「录音 → 转写 → 判分 → 落库」这条链在没有供应商时走通
# 接真实供应商时在这里加一个值（模型名同样按用途命名，决策 50）。
DEEPGRILL_STT_PROVIDER=none

# Cookie 的 Secure 属性。本机 http 开发留 false；**线上必须 true**。
DEEPGRILL_SESSION_COOKIE_SECURE=false

# 启动时拒绝带着占位口令的库（决策 58）。**线上必须 true**：
# 迁移会种一个 `owner@local`，它的口令哈希是明文可读的 `PLACEHOLDER__…` ——
# 不替换就能被任何人拿到 owner 权限。打开这个开关之后，那种库**拒绝启动**。
# 本机留 false（开发就是从占位账号开始的，强行要求会让这个检查被绕过）。
DEEPGRILL_REQUIRE_SECURE_DB=false
