# 配置模板：复制成 .env 再填真实值。
#
#   Copy-Item .env.example .env      # Windows
#   cp .env.example .env             # macOS / Linux
#
# ⚠️ `.env` 已被 .gitignore 挡住（它装的是密钥）。**只提交这个模板**，
# 不要在模板里写真实值 —— 那等于把密钥提交进库。
#
# 环境变量的优先级高于本文件：临时换一次不必改文件，
#   $env:DEEPGRILL_LLM_API_KEY = "sk-…"     # Windows PowerShell
#   export DEEPGRILL_LLM_API_KEY=sk-…       # macOS / Linux

# 模型与密钥。留空时应用**仍然起得来**：判定走降级路径（页面明确提示、
# 本轮记为「未涉及」、会话不中断），但不会真的调用模型。
DEEPGRILL_LLM_API_KEY=
DEEPGRILL_LLM_BASE_URL=https://api.deepseek.com
DEEPGRILL_MODEL_INTERVIEWER=deepseek-flash

# 库路径（相对仓库根解析）。默认 data/interview.db，一般不用改。
# DEEPGRILL_DATABASE_PATH=data/interview.db

# 语音转写（决策 32：面试页默认语音作答）。
#   none（默认）= 没接供应商：每次调用**明确失败**，页面让人改用打字（不拿假转写骗判分）
#   fake        = 占位实现：返回一段**标着占位**的文字，只为把
#                 「录音 → 转写 → 判分 → 落库」这条链在没有供应商时走通
# 接真实供应商时在这里加一个值（模型名同样按用途命名，决策 50）。
DEEPGRILL_STT_PROVIDER=none

# 嵌入（ADR-0008：**走 API，不跑本地模型**）。知识层的聚类与召回要用它。
# ⚠️ **DeepSeek 不提供 embeddings**（调 /v1/embeddings 直接 404），所以要另配一家。
#   none（默认）= 没接：每次调用明确失败。**没配之前全量装配跑不了。**
#   fake        = 确定性的词袋哈希向量：让整条装配管道（分批 → 聚类 → 逐簇判断）
#                 在没有供应商时被真的走一遍，且结果可复现。**它不是语义嵌入**，
#                 同义不同词不会被它拉近 —— 真跑全量之前必须换成 api。
#   api         = OpenAI 兼容的 /embeddings（下面三项要配齐）
DEEPGRILL_EMBEDDING_PROVIDER=none
DEEPGRILL_EMBEDDING_MODEL=
DEEPGRILL_EMBEDDING_BASE_URL=
DEEPGRILL_EMBEDDING_API_KEY=

# Cookie 的 Secure 属性。本机 http 开发留 false；**线上必须 true**。
DEEPGRILL_SESSION_COOKIE_SECURE=false

# 限流（决策 66：滑动窗口 + reserve/settle）。三档分别是「按 IP 的全部请求」
# 「按 IP 的登录/注册」与「按用户的面试官动作」。一般不用改；调大调小都在这里。
DEEPGRILL_RATELIMIT_ENABLED=true
DEEPGRILL_RATELIMIT_REQUESTS=120
DEEPGRILL_RATELIMIT_AUTH_REQUESTS=10
DEEPGRILL_RATELIMIT_LLM_REQUESTS=20

# 是否信任反向代理的转发头（CF-Connecting-IP / X-Forwarded-For）。
# **默认 false**，因为转发头是客户端能自己写的 —— 信了它，按 IP 限流就变成
# "按客户端随便填的字符串限流"。**线上跑在 Cloudflare 后面时必须改成 true**，
# 否则所有请求看起来都来自同一个 IP（Cloudflare 的边缘节点）。
DEEPGRILL_TRUST_PROXY_HEADERS=false

# 启动时拒绝带着占位口令的库（决策 58）。**线上必须 true**：# 迁移会种一个 `owner@local`，它的口令哈希是明文可读的 `PLACEHOLDER__…` ——
# 不替换就能被任何人拿到 owner 权限。打开这个开关之后，那种库**拒绝启动**。
# 本机留 false（开发就是从占位账号开始的，强行要求会让这个检查被绕过）。
DEEPGRILL_REQUIRE_SECURE_DB=false
