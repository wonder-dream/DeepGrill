#!/bin/sh
# 提交前自动校验：文档一致性 + lint + 类型检查。
#
# 为什么必须有这个 hook：AGENTS.md 第 5 条写着"提交前跑校验"，决策 38 写着
# "**类型检查与 lint 提交前自动跑**"，但**一条必须靠自己记得跑的检查等于没有** ——
# 这正是本项目反复吃过的亏（v1 的 471 个测试写完却从未在根目录跑起来）。
#
# 安装：git config core.hooksPath .githooks
# 跳过（不推荐）：git commit --no-verify

set -e

# 找一个能用的 python
PY=""
for cand in python3 python py; do
    if command -v "$cand" >/dev/null 2>&1; then PY="$cand"; break; fi
done
if [ -z "$PY" ]; then
    echo "pre-commit: 找不到 python，跳过文档校验（请装 Python 或手工跑 scripts/check_docs.py）" >&2
    exit 0
fi

echo "pre-commit: 提交动作检查（台账编号 / 影响文档 / 被删的数字）…"
if ! "$PY" scripts/check_staged.py; then
    echo "" >&2
    echo "提交被拦下：台账里已有编号的决策被就地改写了。" >&2
    echo "反转一条已落地的决策要**新增一个编号写新结论 + 旧行标「废止」**；" >&2
    echo "只是措辞修订就在行内写「文字修订」。详见 scripts/check_staged.py 的文件头。" >&2
    exit 1
fi

echo "pre-commit: 文档一致性校验…"
if ! "$PY" scripts/check_docs.py; then
    echo "" >&2
    echo "提交被拦下：文档不一致。修好后重跑：python scripts/check_docs.py" >&2
    echo "（确实要跳过：git commit --no-verify，但请先想清楚为什么）" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# lint 与类型检查（决策 38）。
#
# ⚠️ **工具不在就跳过，但要说出来**：本机开发环境不一定装了 dev extra，
# 而"装不上就提交不了"会让人用 --no-verify（那比没有检查更糟 —— 它连文档校验
# 一起跳过）。所以这里只跳过 lint，并明确提示怎么装。
#
# 只查**暂存的 python 文件**：改文档时没必要跑一遍全库类型检查（它要十几秒）。
# 但传给 ruff/mypy 的是暂存文件列表 —— 没暂存任何 .py 时整段跳过。
# ---------------------------------------------------------------------------
STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)

if [ -n "$STAGED_PY" ]; then
    if "$PY" -m ruff --version >/dev/null 2>&1; then
        echo "pre-commit: ruff（lint）…"
        # shellcheck disable=SC2086  # 需要按行拆成多个参数
        if ! "$PY" -m ruff check $STAGED_PY; then
            echo "" >&2
            echo "提交被拦下：lint 没过。自动能修的先跑：python -m ruff check --fix ." >&2
            exit 1
        fi
    else
        echo "pre-commit: 没装 ruff，跳过 lint（python -m pip install -e '.[dev]'）" >&2
    fi

    if "$PY" -m mypy --version >/dev/null 2>&1; then
        echo "pre-commit: mypy（类型检查）…"
        if ! "$PY" -m mypy; then
            echo "" >&2
            echo "提交被拦下：类型检查没过。配置与两条被关掉的错误码的理由见 pyproject.toml。" >&2
            exit 1
        fi
    else
        echo "pre-commit: 没装 mypy，跳过类型检查（python -m pip install -e '.[dev]'）" >&2
    fi
fi

# 只在校验器或文档本身有改动时，才跑自检（它们比较慢）
if git diff --cached --name-only | grep -qE '^(scripts/|docs/|CONTEXT\.md|AGENTS\.md|README\.md)'; then
    echo "pre-commit: 校验器自检（变异测试 + 规则用例）…"
    ok=1
    "$PY" scripts/selftest_check_docs.py || ok=0
    "$PY" scripts/selftest_check_staged.py || ok=0
    # 验收执行器的自检比较慢（它要真跑几条测试），所以只在**它自己**改动时跑 ——
    # 改别的文档时没必要把它拖进来（那会让人开始用 --no-verify）。
    if git diff --cached --name-only | grep -q '^scripts/check_acceptance\.py'; then
        "$PY" scripts/selftest_check_acceptance.py || ok=0
    fi
    if [ "$ok" -ne 1 ]; then
        echo "" >&2
        echo "提交被拦下：校验器自检未通过 —— 某条规则已失效，或测试本身无效。" >&2
        echo "这意味着文档的自动保障出现了缺口，请先修校验器。" >&2
        exit 1
    fi
fi

exit 0
